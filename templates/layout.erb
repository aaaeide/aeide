<!DOCTYPE html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/face_with_cowboy_hat.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= page[:title] %> &middot; <%= site[:title] %></title>
    <style>
      :root {
        font-family: Georgia, "Times New Roman", serif;
        background-color: black;
        color: white;
        line-height: 1.5;
        --border: rgba(255, 165, 0, 0.45);
      }

      * {
        box-sizing: border-box;
      }

      a {
        color: orange;
      }

      .navbar {
        border-bottom: 1px dashed orange;
        padding: 0.75em 1em;
        max-width: 600px;
        margin: 0 auto;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.75em;
        font-family: monospace;
        letter-spacing: 0.1em;
        color: orange;
      }

      .brand img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--border);
        object-fit: cover;
      }

      .navbar nav {
        display: flex;
        gap: 1em;
        margin-top: 0.75em;
        font-family: monospace;
      }

      .navbar nav a {
        color: white;
        text-decoration: none;
      }

      .navbar nav a.active {
        color: orange;
        text-decoration: underline;
      }

      main {
        max-width: 600px;
        margin: 0 auto;
        padding: 1em;
      }

      .box {
        border: 1px solid var(--border);
        padding: 1em;
        margin-bottom: 1em;
      }

      .box header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1em;
        font-family: monospace;
        color: orange;
        border-bottom: 1px dashed orange;
        padding-bottom: 0.5em;
        margin-bottom: 0.5em;
      }

      .box header a {
        color: orange;
        text-decoration: none;
      }

      .box header a:hover {
        text-decoration: underline;
      }

      .box header time {
        color: white;
        font-size: 0.85em;
      }

      .box .meta {
        font-family: monospace;
        color: orange;
        font-size: 0.85em;
        margin-bottom: 0.75em;
      }

      .feed-title {
        font-family: monospace;
        font-weight: normal;
        color: orange;
        font-size: 1.25em;
        border-bottom: 1px dashed orange;
        padding-bottom: 0.5em;
        margin: 0 0 1em;
      }

      .file-path {
        font-family: monospace;
        font-size: 0.75em;
        color: #777;
        margin: 0 0 0.75em;
      }

      .file-path a {
        color: inherit;
        text-decoration: none;
      }

      .file-path a:hover {
        text-decoration: underline;
      }

      .writing {
        position: relative;
        border: 1px solid var(--border);
        clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 0 100%);
        padding: 1.5em;
        margin-bottom: 1em;
      }

      .writing::after {
        content: "";
        position: absolute;
        top: -1px;
        right: -1px;
        width: 24px;
        height: 24px;
        pointer-events: none;
        background:
          linear-gradient(225deg, transparent calc(50% - 1px), var(--border) calc(50% - 1px), var(--border) calc(50% + 1px), transparent calc(50% + 1px)),
          linear-gradient(90deg, var(--border) 0 1px, transparent 1px),
          linear-gradient(0deg, var(--border) 0 1px, transparent 1px),
          linear-gradient(225deg, transparent 50%, #3a3a3a 50%);
      }

      .writing-header {
        border-bottom: 1px dashed orange;
        padding-bottom: 0.75em;
        margin-bottom: 1.25em;
      }

      .writing-header h1 {
        font-family: monospace;
        font-weight: normal;
        color: orange;
        font-size: 1.5em;
        margin: 0 0 0.3em;
      }

      .writing-meta {
        font-family: monospace;
        font-size: 0.9em;
        color: white;
        margin: 0;
      }

      .writing-meta .author,
      .writing-meta .year {
        color: orange;
      }

      .writing-body {
        line-height: 1.75;
      }

      .writing-source {
        font-family: monospace;
        font-size: 0.85em;
        margin: 1.25em 0 0;
        padding-top: 0.75em;
        border-top: 1px dashed orange;
      }
    </style>
  </head>
  <body>
    <header class="navbar">
      <div class="brand">
        <img src="/meg-thumb.jpg" alt="Andreas Aaberge Eide" />
        <span><%= site[:title] %></span>
      </div>
      <nav>
        <% site[:nav].each do |item| %>
          <a href="<%= item[:url] %>"<% if item[:external] %> target="_blank" rel="noopener"<% end %><% active = item[:url] == "/" ? page[:url] == "/" : page[:url].start_with?(item[:url]) %><% if active %> class="active"<% end %>><%= item[:title] %></a>
        <% end %>
      </nav>
    </header>
    <main>
      <%= page[:html] %>
    </main>
  </body>
</html>
